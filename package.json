{
  "name": "usability-test-mcp",
  "version": "0.13.1",
  "private": true,
  "description": "Usability tests for websites, localhost and Figma flows: synthetic participants, real browser, evidence-backed reports. Works in Claude Code and Codex.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "fixture": "tsx tests/fixtures/serve.ts",
    "demo": "tsx examples/demo.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:installer",
    "prepare": "npm run build",
    "test:installer": "node --test tests/installer/*.test.mjs",
    "readme-assets": "tsx scripts/readme-assets.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "bin": {
    "usability-test-mcp": "bin/usability-test-mcp.mjs"
  },
  "files": [
    "bin/",
    "dist/src/**/*.js",
    "assets/",
    "README.md",
    "LICENSE",
    "docs/*.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielhidalgow/usability-test-mcp.git"
  },
  "homepage": "https://github.com/gabrielhidalgow/usability-test-mcp#readme",
  "bugs": {
    "url": "https://github.com/gabrielhidalgow/usability-test-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "usability-testing",
    "ux",
    "ux-research",
    "claude-code",
    "codex",
    "figma",
    "playwright",
    "accessibility"
  ]
}
